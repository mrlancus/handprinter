# Copy to .env and adjust. All values are optional.
# Where images, crops, packages, checkpoints and the SQLite DB live (outside Git).
HANDPRINTER_DATA_DIR=~/handprinter-data
# Loopback by default. A non-loopback host also requires HANDPRINTER_ACCESS_TOKEN.
HANDPRINTER_HOST=127.0.0.1
HANDPRINTER_PORT=8765
HANDPRINTER_ACCESS_TOKEN=
# Online mode (scripts\online.bat / `python -m handprinter online`), see docs/online.md.
# Sign-in password for the website. Blank = 6892.
HANDPRINTER_PASSWORD=
# Optional: a named Cloudflare Tunnel for a permanent address (blank = a new trycloudflare.com address each start).
HANDPRINTER_TUNNEL_TOKEN=
HANDPRINTER_PUBLIC_URL=
# Recognition model alias used by the Claude Code subagent (must match .claude/agents/handwriting-recogniser.md).
HANDPRINTER_RECOGNITION_MODEL=haiku
# Headless recognition through the local `claude` CLI: blank = off locally, on in online mode; 0/1 to force.
HANDPRINTER_HEADLESS_RECOGNITION=
HANDPRINTER_HEADLESS_CONCURRENCY=12
# Model adapter environments (separate venvs/conda envs with PyTorch).
HANDPRINTER_ERUKU_PYTHON=
HANDPRINTER_ERUKU_MODEL=blowing-up-groundhogs/eruku
HANDPRINTER_DIFFUSIONPEN_PYTHON=
HANDPRINTER_DIFFUSIONPEN_REPO=
HANDPRINTER_DIFFUSIONPEN_CHECKPOINT=
